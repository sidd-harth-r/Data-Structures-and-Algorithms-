class Solution {
public:
    vector<vector<int>> ans;
    vector<vector<int>> grid;

    void check(int i, int j, int c, int count) {
        for (int k = 0; k < ans.size(); k++) {
            if (ans[k][0] == i && ans[k][1] == j && ans[k][3] == count) {
                ans[k][2] = max(ans[k][2], c);
                return;
            }
        }
        ans.push_back({i, j, c, count});
    }

    void helper(int k, vector<vector<int>>& sources, queue<int>& q, int count, int n, int m) {
        int i = sources[k][0];
        int j = sources[k][1];
        int c = sources[k][2];


        if (i - 1 >= 0 && grid[i - 1][j] == 0) {
            check(i - 1, j, c, count);
        }
        if (i + 1 < n && grid[i + 1][j] == 0) {
            check(i + 1, j, c, count);
        }
        if (j - 1 >= 0 && grid[i][j - 1] == 0) {
            check(i, j - 1, c, count);
        }
        if (j + 1 < m && grid[i][j + 1] == 0) {
            check(i, j + 1, c, count);
        }
    }

    vector<vector<int>> colorGrid(int n, int m, vector<vector<int>>& sources) {

        grid = vector<vector<int>>(n, vector<int>(m, 0));
        queue<int> q;

    
        for (int i = 0; i < sources.size(); i++) {
            q.push(i);
            int r = sources[i][0];
            int c = sources[i][1];
            int col = sources[i][2];
            grid[r][c] = col;
        }

        q.push(-1);
        int count = 0;

        while (!q.empty()) {
            int p = q.front();
            q.pop();

            if (p == -1) {
                if (q.empty()) break;

    
                for (auto &v : ans) {
                    if (v[3] == count) {
                        int i = v[0], j = v[1], c = v[2];

                        grid[i][j] = c;
                        q.push(sources.size());
                        sources.push_back({i, j, c});
                    }
                }

                count++;
                q.push(-1);
                continue;
            }

            helper(p, sources, q, count, n, m);
        }

        return grid;
    }
};